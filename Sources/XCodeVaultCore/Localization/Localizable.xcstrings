    "perm.requirement.helper.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This path belongs to root, and XCodeVault's only route to root is its privileged helper's fixed list of actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta ruta pertenece a root, y la única vía de XCodeVault hacia root es la lista fija de acciones de su asistente privilegiado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このパスは root の所有です。XCodeVault が root を使う唯一の手段は、特権ヘルパーの決められた操作です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este caminho pertence ao root, e o único acesso do XCodeVault ao root é a lista fixa de ações do seu auxiliar privilegiado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此路径归 root 所有，而 XCodeVault 获得 root 的唯一途径是其特权助手的固定操作列表。"
          }
        }
      }
    },
    "perm.requirement.helperWithFullDiskAccess.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "root with Full Disk Access — privileged helper; its Full Disk Access is unmeasured"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "root con Acceso total al disco — asistente privilegiado; su Acceso total al disco no se ha medido"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フルディスクアクセス付きの root — 特権ヘルパー。ヘルパーのフルディスクアクセスは未計測"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "root com Acesso Total ao Disco — auxiliar privilegiado; o Acesso Total ao Disco dele não foi medido"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "带完全磁盘访问权限的 root — 特权助手；其完全磁盘访问权限尚未测定"
          }
        }
      }
    },
    "perm.requirement.helperWithFullDiskAccess.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This path belongs to root inside a folder where root was refused without Full Disk Access (H15); whether the helper has that access is unmeasured until its first live run (#30)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta ruta pertenece a root, dentro de una carpeta donde se rechazó a root sin Acceso total al disco (H15); si el asistente tiene ese acceso no se habrá medido hasta su primera ejecución real (#30)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このパスは、フルディスクアクセスなしでは root でも拒否されたフォルダ内にある root 所有のパスです（H15）。ヘルパーにそのアクセスがあるかは、最初の実運用まで未計測です（#30）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este caminho pertence ao root, dentro de uma pasta onde o root foi recusado sem Acesso Total ao Disco (H15); se o auxiliar tem esse acesso não foi medido até a sua primeira execução real (#30)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此路径归 root 所有，位于一个在没有完全磁盘访问权限时连 root 也被拒绝的文件夹中（H15）；助手是否拥有该权限，在其首次实际运行之前尚未测定（#30）。"
          }
        }
      }
    },
