        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "先にインストーラを書き出してください: `xcodevaultctl runtime export <platform> --to <dir>`。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primeiro exporte o instalador: `xcodevaultctl runtime export <platform> --to <dir>`."
          }
