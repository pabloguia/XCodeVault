    "perm.helper.why.unavailableInThisBuild" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This build cannot reach the privileged helper: it is not signed by a usable Apple team, or the helper is not in it. That takes a signed build that includes the helper (issue #30)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta compilación no puede acceder al asistente privilegiado: no está firmada por un equipo de Apple utilizable, o el asistente no está incluido. Hace falta una compilación firmada que incluya el asistente (issue #30)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このビルドからは特権ヘルパーを利用できません。使用可能な Apple チームの署名がないか、ヘルパーが含まれていません。ヘルパーを含む署名済みビルドが必要です（issue #30）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta versão não consegue acessar o auxiliar privilegiado: não está assinada por uma equipe Apple utilizável, ou o auxiliar não está nela. É preciso uma versão assinada que inclua o auxiliar (issue #30)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此版本无法使用特权助手：它没有由可用的 Apple 团队签名，或者未包含该助手。需要包含助手的已签名版本（issue #30）。"
          }
        }
      }
    },
