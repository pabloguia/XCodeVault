    "app.run.removeOriginal.dialogMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is compared with the vault copy again first, and nothing is deleted if they differ. The app cannot undo this; the vault copy is what remains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antes se vuelve a comparar con la copia del disco bóveda, y no se elimina nada si difieren. La app no puede deshacerlo; lo que queda es la copia del disco bóveda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "先に保管庫のコピーともう一度比較し、違いがあれば何も削除しません。この操作はアプリでは取り消せません。残るのは保管庫のコピーです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antes, ele é comparado de novo com a cópia no disco-cofre, e nada é apagado se forem diferentes. O app não pode desfazer isso; o que resta é a cópia no disco-cofre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "会先再次与保险库中的拷贝比较,如有差异则不删除任何内容。此操作无法在应用中撤销;保留的是保险库中的拷贝。"
          }
        }
      }
    },
