    "app.delete.otherTools.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are never deleted from this list. Copy a command and run it in Terminal; simulator devices lose their apps and the apps' data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estos nunca se borran desde esta lista. Copia un comando y ejecútalo en Terminal; los dispositivos del simulador pierden sus apps y los datos de las apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これらはこの一覧からは削除されません。コマンドをコピーしてターミナルで実行してください。シミュレータのデバイスはアプリとそのデータを失います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estes nunca são apagados por esta lista. Copie um comando e execute-o no Terminal; os dispositivos do simulador perdem os apps e os dados dos apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这些项目绝不会从此列表中删除。请拷贝命令并在“终端”中运行；模拟器设备会丢失其中的 App 及其数据。"
          }
        }
      }
    },
