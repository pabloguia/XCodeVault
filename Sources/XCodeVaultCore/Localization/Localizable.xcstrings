          }
        }
      }
    },
    "cli.cmd.locations.setArchives.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point new Archives at a directory (IDECustomDistributionArchivesLocation; reproduced on Xcode 26.5, status: probable). Existing archives are not moved — use `externalize --category archives`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apunta los nuevos Archives a una carpeta (IDECustomDistributionArchivesLocation; reproducido en Xcode 26.5, estado: probable). Los archives existentes no se mueven: usa `externalize --category archives`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新しい Archives の保存先をフォルダに変更します（IDECustomDistributionArchivesLocation。Xcode 26.5 で再現済み、状態: 有望）。既存のアーカイブは移動されません — `externalize --category archives` を使ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aponta os novos Archives para uma pasta (IDECustomDistributionArchivesLocation; reproduzido no Xcode 26.5, status: provável). Os archives existentes não são movidos — use `externalize --category archives`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将新的 Archives 指向一个文件夹（IDECustomDistributionArchivesLocation；已在 Xcode 26.5 上复现，状态：可能可行）。现有的归档不会被移动——请使用 `externalize --category archives`。"
          }
        }
      }
    },
    "cli.cmd.locations.setCompilationCache.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point the Xcode 26 compilation cache at a directory (IDECustomCompilationCacheLocation)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apunta la caché de compilación de Xcode 26 a una carpeta (IDECustomCompilationCacheLocation)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xcode 26 のコンパイルキャッシュの場所をフォルダに変更します（IDECustomCompilationCacheLocation）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aponta o cache de compilação do Xcode 26 para uma pasta (IDECustomCompilationCacheLocation)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将 Xcode 26 的编译缓存指向一个文件夹（IDECustomCompilationCacheLocation）。"
          }
        }
      }
    },
    "cli.cmd.locations.setDerivedData.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point DerivedData at a directory (IDECustomDerivedDataLocation; reproduced on Xcode 26.5; the compatibility matrix is not complete yet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apunta DerivedData a una carpeta (IDECustomDerivedDataLocation; reproducido en Xcode 26.5; la matriz de compatibilidad aún no está completa)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "DerivedData の場所をフォルダに変更します（IDECustomDerivedDataLocation。Xcode 26.5 で再現済み。互換性マトリクスはまだ完成していません）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aponta o DerivedData para uma pasta (IDECustomDerivedDataLocation; reproduzido no Xcode 26.5; a matriz de compatibilidade ainda não está completa)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将 DerivedData 指向一个文件夹（IDECustomDerivedDataLocation；已在 Xcode 26.5 上复现；兼容性矩阵尚未完成）。"
          }
        }
      }
    },
    "cli.cmd.migration.abort.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the partial destination copy of a migration interrupted before verification; refuses after verification; the source is never touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina la copia parcial en el destino de una migración interrumpida antes de la verificación; se niega después de la verificación; el origen nunca se toca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "検証前に中断された移行の、移行先にある部分コピーを削除します。検証後は拒否します。元のデータには一切触れません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove a cópia parcial no destino de uma migração interrompida antes da verificação; recusa depois da verificação; a origem nunca é tocada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "删除在校验前中断的迁移在目标位置留下的部分副本；校验后会拒绝执行；从不触碰源数据。"
          }
        }
      }
    },
    "cli.cmd.migration.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect, abort (pre-verification) or resume (post-verification) interrupted migrations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inspecciona, cancela (antes de la verificación) o reanuda (después de la verificación) migraciones interrumpidas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "中断された移行を確認、中止（検証前）、または再開（検証後）します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inspeciona, aborta (antes da verificação) ou retoma (depois da verificação) migrações interrompidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "检查、中止（校验前）或继续（校验后）中断的迁移。"
          }
        }
      }
    },
    "cli.cmd.migration.forget.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close out a migration this tool will not finish for you, after you have compared both copies by hand. Touches no files; only clears the journal entry so migrations can run again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cierra una migración que esta herramienta no terminará por ti, después de que hayas comparado ambas copias a mano. No toca ningún archivo; solo borra la entrada del registro para que las migraciones puedan volver a ejecutarse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このツールでは完了できない移行を、両方のコピーを手動で比較した後に終了扱いにします。ファイルには触れず、移行を再び実行できるようジャーナルの項目を消すだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encerra uma migração que esta ferramenta não vai concluir por você, depois que você comparou as duas cópias manualmente. Não toca em nenhum arquivo; só limpa a entrada do registro para que migrações possam rodar de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你手动比较两份副本后，结束一个本工具无法替你完成的迁移。不触碰任何文件；只清除日志条目，以便迁移可以再次运行。"
          }
        }
      }
    },
    "cli.cmd.migration.resume.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish a cleanup interrupted after verification: re-verify the renamed-aside original against the vault copy, then remove it (or restore it if they differ)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina una limpieza interrumpida después de la verificación: vuelve a verificar el original renombrado contra la copia del disco bóveda y luego lo elimina (o lo restaura si difieren)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "検証後に中断された後片付けを完了します: 別名に退避した元のデータを保管用ボリュームのコピーと再検証し、削除します（異なる場合は元に戻します）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conclui uma limpeza interrompida depois da verificação: verifica de novo o original renomeado contra a cópia no disco-cofre e então o remove (ou o restaura, se forem diferentes)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "完成在校验后中断的清理：将改名搁置的原始数据与保管宗卷中的副本重新校验，然后删除它（若两者不同则将其恢复）。"
          }
        }
      }
    },
    "cli.cmd.migration.status.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrupted migrations, leftover partial copies, and copies you closed out by hand that may still be on disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Migraciones interrumpidas, copias parciales sobrantes y copias que cerraste a mano y que aún pueden estar en el disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "中断された移行、残っている部分コピー、手動で終了扱いにしたがまだディスクに残っている可能性のあるコピー。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Migrações interrompidas, cópias parciais restantes e cópias que você encerrou manualmente e que ainda podem estar no disco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
