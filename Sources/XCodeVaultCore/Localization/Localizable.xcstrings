                  "state" : "needs_review",
                  "value" : "%lld 個のフォルダを読み取れませんでした。フルディスクアクセスがあれば XCodeVault が計測できる可能性があります。"
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld pasta não pôde ser lida; o Acesso Total ao Disco pode permitir que o XCodeVault a meça."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld pastas não puderam ser lidas; o Acesso Total ao Disco pode permitir que o XCodeVault as meça."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lld 个文件夹无法读取；完全磁盘访问权限可能让 XCodeVault 能够计算它们的大小。"
                }
              }
            }
          }
        }
      }
    },
