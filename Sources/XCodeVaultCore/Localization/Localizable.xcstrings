    "cli.plan.note.archivesPark" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies and verifies first; the original is removed only in a second, explicit step."
          }
        },
        "es" : {
          "stringUnit" : {
