    "app.run.interrupted.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was interrupted, or it failed and part of its copy may still be on disk. Run these in Terminal to see its state and resolve it; the app does not resume or abort migrations yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se interrumpió, o falló y parte de su copia puede seguir en el disco. Ejecuta estos comandos en Terminal para ver su estado y resolverla; la app aún no reanuda ni anula migraciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "中断されたか、失敗してコピーの一部がディスクに残っている可能性があります。ターミナルで次のコマンドを実行して状態を確認し、解決してください。アプリはまだ移行の再開や中止を行いません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ela foi interrompida, ou falhou e parte da cópia pode ainda estar no disco. Execute estes comandos no Terminal para ver o estado e resolvê-la; o app ainda não retoma nem cancela migrações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
