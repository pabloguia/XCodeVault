    "app.error.helper.unavailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This build can’t reach the privileged helper: it isn’t signed by a usable Apple team, or the helper isn’t in it. That needs a signed build that includes the helper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta compilación no puede comunicarse con el asistente privilegiado: no está firmada por un equipo de Apple válido o no incluye el asistente. Hace falta una compilación firmada que lo incluya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このビルドは特権ヘルパーに接続できません。使用可能な Apple チームで署名されていないか、ヘルパーが含まれていません。ヘルパーを含む署名済みビルドが必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta versão não consegue acessar o auxiliar privilegiado: ela não é assinada por uma equipe Apple utilizável ou não inclui o auxiliar. É preciso uma versão assinada que inclua o auxiliar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此版本无法连接特权助手：它未由可用的 Apple 团队签名，或未包含助手。需要一个包含助手的已签名版本。"
          }
        }
      }
    },
