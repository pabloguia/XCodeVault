{
  "sourceLanguage" : "en",
  "strings" : {
    "cli.cmd.bench.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualify a drive for developer workloads: 4 KiB random IOPS at QD1 and small-file metadata rate, not sequential MB/s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evalúa un disco para cargas de desarrollo: IOPS aleatorias de 4 KiB con QD1 y tasa de metadatos de archivos pequeños, no MB/s secuenciales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "開発作業向けにドライブを評価します: 連続 MB/s ではなく、QD1 での 4 KiB ランダム IOPS と小さなファイルのメタデータ処理速度。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avalia um disco para cargas de desenvolvimento: IOPS aleatórios de 4 KiB em QD1 e taxa de metadados de arquivos pequenos, não MB/s sequenciais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "评估磁盘是否适合开发工作负载：看 QD1 下的 4 KiB 随机 IOPS 和小文件元数据速率，而不是顺序 MB/s。"
          }
        }
      }
    },
    "cli.cmd.clean.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan (default) or apply deletion of regenerable developer data. Never touches Archives or anything non-regenerable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planifica (por omisión) o aplica la eliminación de datos de desarrollo regenerables. Nunca toca Archives ni nada que no se pueda regenerar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "再生成できる開発データの削除を計画（既定）または実行します。Archives や再生成できないものには一切触れません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planeja (padrão) ou aplica a exclusão de dados de desenvolvimento regeneráveis. Nunca toca em Archives nem em nada que não possa ser regenerado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "规划（默认）或执行删除可再生成的开发数据。从不触碰 Archives 或任何无法再生成的数据。"
          }
        }
      }
    },
    "cli.cmd.compatibility.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every storage category with its strategy, evidence status and privilege level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada categoría de almacenamiento con su estrategia, estado de la evidencia y nivel de privilegio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべてのストレージカテゴリと、その方式、根拠の状態、必要な権限レベル。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada categoria de armazenamento com sua estratégia, estado das evidências e nível de privilégio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个存储类别及其方案、证据状态和权限级别。"
          }
        }
      }
    },
    "cli.cmd.doctor.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detect broken/unsafe configurations and propose (never execute) repairs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detecta configuraciones rotas o inseguras y propone reparaciones (nunca las ejecuta)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "壊れた構成や安全でない構成を検出し、修復方法を提案します（実行はしません）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detecta configurações quebradas ou inseguras e propõe reparos (sem nunca executá-los)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "检测损坏或不安全的配置，并提出修复建议（从不执行）。"
          }
        }
      }
    },
    "cli.cmd.externalize.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy a cold-storage category (Archives) to a verified vault volume with deep verification. The source is kept unless --remove-source-after-verify is given."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia una categoría de almacenamiento en frío (Archives) a un disco bóveda verificado, con verificación completa. El origen se conserva salvo que se indique --remove-source-after-verify."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コールドストレージのカテゴリ（Archives）を、検証済みの保管用ボリュームへ詳細な検証付きでコピーします。--remove-source-after-verify を指定しない限り、元のデータは残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia uma categoria de armazenamento frio (Archives) para um disco-cofre verificado, com verificação completa. A origem é mantida, a menos que --remove-source-after-verify seja passado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将冷存储类别（Archives）复制到已校验的保管宗卷，并进行完整校验。除非指定 --remove-source-after-verify，否则保留源数据。"
          }
        }
      }
    },
    "cli.cmd.journal.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the operation journal (every change XCodeVault made, and any interrupted operation)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra el registro de operaciones (cada cambio que hizo XCodeVault y cualquier operación interrumpida)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "操作ジャーナルを表示します（XCodeVault が行ったすべての変更と、中断された操作）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra o registro de operações (cada alteração que o XCodeVault fez e qualquer operação interrompida)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "显示操作日志（XCodeVault 做出的每项更改，以及任何中断的操作）。"
          }
        }
      }
    },
    "cli.cmd.locations.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode ▸ Settings ▸ Locations (DerivedData, Archives) — Apple's supported relocation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xcode ▸ Ajustes ▸ Ubicaciones (DerivedData, Archives): la reubicación que Apple admite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xcode ▸ 設定 ▸ 場所（DerivedData、Archives）— Apple がサポートする移動方法。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xcode ▸ Ajustes ▸ Localizações (DerivedData, Archives) — a realocação suportada pela Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xcode ▸ 设置 ▸ 位置（DerivedData、Archives）— Apple 支持的迁移方式。"
          }
        }
      }
    },
    "cli.cmd.locations.resetArchives.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore Xcode's default Archives location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restablece la ubicación predeterminada de Archives en Xcode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xcode の Archives の場所を既定に戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restaura o local padrão dos Archives no Xcode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "恢复 Xcode 默认的 Archives 位置。"
          }
        }
      }
    },
    "cli.cmd.locations.resetCompilationCache.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore the default compilation cache location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restablece la ubicación predeterminada de la caché de compilación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コンパイルキャッシュの場所を既定に戻します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restaura o local padrão do cache de compilação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "恢复默认的编译缓存位置。"
          }
        }
      }
    },
    "cli.cmd.locations.resetDerivedData.abstract" : {
      "localizations" : {
