    "perm.fda.why.granted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This process can open the one file only Full Disk Access opens (H15's indicator; nothing is read from it)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este proceso puede abrir el único archivo que solo abre el Acceso total al disco (el indicador de H15; no se lee nada de él)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このプロセスは、フルディスクアクセスでしか開けないファイルを開けます（H15 の指標。内容は読み取りません）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este processo consegue abrir o único arquivo que só o Acesso Total ao Disco abre (o indicador do H15; nada é lido dele)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此进程可以打开只有完全磁盘访问权限才能打开的那个文件（H15 的指示文件；不会读取其中任何内容）。"
          }
        }
      }
    },
    "perm.fda.why.notGranted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS refused this process the one file only Full Disk Access opens, so folders macOS protects cannot be measured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS denegó a este proceso el único archivo que solo abre el Acceso total al disco, así que no se pueden medir las carpetas que macOS protege."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS は、フルディスクアクセスでしか開けないファイルをこのプロセスに開かせませんでした。そのため macOS が保護するフォルダは計測できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O macOS negou a este processo o único arquivo que só o Acesso Total ao Disco abre, então as pastas que o macOS protege não podem ser medidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 拒绝此进程打开只有完全磁盘访问权限才能打开的那个文件，因此无法计算 macOS 保护的文件夹的大小。"
          }
        }
      }
    },
    "perm.fda.why.unknown" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The check could not tell: the indicator file failed to open for a reason other than macOS privacy protection."
          }
