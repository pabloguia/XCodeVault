    "app.quit.couldNotStop.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The running command did not stop, even when forced. XCodeVault stays open so nothing goes on running unseen; the operation is still shown in its sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El comando en curso no se detuvo, ni siquiera forzándolo. XCodeVault sigue abierto para que nada siga ejecutándose sin que se vea; la operación sigue en su hoja."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "実行中のコマンドは強制しても停止しませんでした。気づかないまま実行が続かないよう XCodeVault は開いたままです。操作はシートに表示されたままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O comando em andamento não parou, nem quando forçado. O XCodeVault continua aberto para que nada continue rodando sem ser visto; a operação ainda aparece na sua janela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "正在运行的命令即使强制也未停止。XCodeVault 保持打开,以免有任何内容在不被察觉的情况下继续运行;该操作仍显示在其表单中。"
          }
        }
      }
    },
