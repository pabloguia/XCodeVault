    "app.access.helper.action.manualRoute" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where there is a manual route, run the step that `xcodevaultctl doctor` or `xcodevaultctl vault init` prints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando hay una vía manual, ejecuta el paso que muestra `xcodevaultctl doctor` o `xcodevaultctl vault init`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "手動の方法がある場合は、`xcodevaultctl doctor` または `xcodevaultctl vault init` が表示する手順を実行してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando há um caminho manual, execute o passo que `xcodevaultctl doctor` ou `xcodevaultctl vault init` mostra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如有手动方法，请运行 `xcodevaultctl doctor` 或 `xcodevaultctl vault init` 显示的步骤。"
          }
        }
      }
    },
    "app.access.helper.action.signedReleaseOrCLI" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs a signed build that includes the helper; none is released yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Requiere una compilación firmada que incluya el asistente; todavía no se ha publicado ninguna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ヘルパーを含む署名済みビルドが必要です。まだ公開されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Requer uma versão assinada que inclua o auxiliar; nenhuma foi lançada ainda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "需要包含助手的已签名版本；目前尚未发布。"
          }
        }
      }
    },
    "app.access.helper.why.enabled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The privileged helper is installed. It runs only its fixed list of actions that need root."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El asistente privilegiado está instalado. Solo ejecuta su lista fija de acciones que necesitan root."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "特権ヘルパーはインストール済みです。root が必要な、決められた操作だけを実行します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O auxiliar privilegiado está instalado. Ele executa apenas sua lista fixa de ações que precisam de root."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "特权助手已安装。它只执行其固定列表中需要 root 的操作。"
          }
        }
      }
    },
    "app.access.helper.why.rootActions" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some actions need root; XCodeVault reaches root only through the privileged helper's fixed list of actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algunas acciones necesitan root; XCodeVault solo llega a root mediante la lista fija de acciones del asistente privilegiado."
          }
        },
        "ja" : {
          "stringUnit" : {
