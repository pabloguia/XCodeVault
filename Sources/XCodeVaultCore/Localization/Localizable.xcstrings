    "perm.requirement.appFullDiskAccess.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS privacy protection stopped XCodeVault from reading some folders, so their sizes are missing from the totals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protección de privacidad de macOS impidió que XCodeVault leyera algunas carpetas, así que sus tamaños faltan en los totales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS のプライバシー保護により XCodeVault が一部のフォルダを読み取れなかったため、それらのサイズは合計に含まれていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A proteção de privacidade do macOS impediu o XCodeVault de ler algumas pastas, então os tamanhos delas não estão nos totais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 隐私保护阻止了 XCodeVault 读取某些文件夹，因此它们的大小未计入总量。"
          }
        }
      }
    },
    "perm.requirement.helper.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "root — privileged helper"
          }
        },
