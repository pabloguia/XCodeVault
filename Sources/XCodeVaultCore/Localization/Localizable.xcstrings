    "app.access.helper.action.signedReleaseOrCLI" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This build cannot reach the privileged helper. Use the signed release of XCodeVault, or, where there is a manual route, run the step that `xcodevaultctl doctor` or `xcodevaultctl vault init` prints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta compilación no puede acceder al asistente privilegiado. Usa la versión firmada de XCodeVault o, cuando haya un camino manual, ejecuta el paso que muestra `xcodevaultctl doctor` o `xcodevaultctl vault init`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このビルドからは特権ヘルパーを利用できません。署名済みの XCodeVault を使うか、手動の手順がある場合は `xcodevaultctl doctor` または `xcodevaultctl vault init` が表示する手順を実行してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta versão não consegue acessar o auxiliar privilegiado. Use a versão assinada do XCodeVault ou, quando houver um caminho manual, execute o passo que `xcodevaultctl doctor` ou `xcodevaultctl vault init` mostra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此版本无法使用特权助手。请使用已签名的 XCodeVault 发行版；若有手动步骤，也可以执行 `xcodevaultctl doctor` 或 `xcodevaultctl vault init` 列出的步骤。"
          }
        }
      }
    },
    "app.access.helper.why.enabled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The privileged helper is installed. It runs only its fixed list of actions that need root."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El asistente privilegiado está instalado. Solo ejecuta su lista fija de acciones que necesitan root."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "特権ヘルパーはインストール済みです。root が必要な、決められた操作だけを実行します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O auxiliar privilegiado está instalado. Ele executa apenas sua lista fixa de ações que precisam de root."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "特权助手已安装。它只执行其固定列表中需要 root 的操作。"
          }
        }
      }
    },
    "app.access.helper.why.rootActions" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some actions need root; XCodeVault reaches root only through the privileged helper's fixed list of actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algunas acciones necesitan root; XCodeVault solo llega a root mediante la lista fija de acciones del asistente privilegiado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一部の操作には root が必要です。XCodeVault が root を使うのは、特権ヘルパーの決められた操作を通じてだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algumas ações precisam de root; o XCodeVault só chega ao root pela lista fixa de ações do auxiliar privilegiado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有些操作需要 root；XCodeVault 只能通过特权助手的固定操作列表获得 root。"
          }
        }
      }
    },
    "app.access.helper.why.rootOnlyBytes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can be deleted only with root, through the privileged helper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ solo se pueden eliminar con root, mediante el asistente privilegiado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ は root でのみ削除でき、特権ヘルパーを通じて行います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ só podem ser apagados com root, por meio do auxiliar privilegiado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 只能以 root 身份通过特权助手删除。"
          }
        }
      }
    },
