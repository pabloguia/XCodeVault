    },
    "perm.helper.why.enabled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS reports the helper as enabled. That is an installation hint: every connection is still checked against the helper's code signature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS indica que el asistente está activado. Es solo una pista de instalación: cada conexión se sigue comprobando con la firma de código del asistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS はヘルパーを有効と報告しています。これはインストールの目安にすぎず、接続のたびにヘルパーのコード署名を確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O macOS informa que o auxiliar está ativado. Isso é só uma indicação de instalação: cada conexão continua sendo verificada pela assinatura de código do auxiliar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 报告助手已启用。这只是安装提示：每次连接仍会根据助手的代码签名进行检查。"
          }
        }
      }
    },
