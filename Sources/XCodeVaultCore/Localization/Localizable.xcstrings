    "app.clean.confirm.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only regenerable data is listed here. Xcode will rebuild it on demand. Non-regenerable data (Archives) never appears in this list. Deletions are journaled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aquí solo aparecen datos que se pueden regenerar. Xcode los vuelve a crear cuando los necesita. Los datos que no se pueden regenerar (Archives) nunca aparecen en esta lista. Las eliminaciones quedan registradas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ここには再生成できるデータだけが表示されます。Xcode が必要に応じて作り直します。再生成できないデータ（Archives）はこの一覧に表示されません。削除はジャーナルに記録されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Só dados regeneráveis aparecem aqui. O Xcode os recria quando precisar. Dados que não podem ser regenerados (Archives) nunca aparecem nesta lista. As exclusões ficam registradas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这里只列出可以重新生成的数据，Xcode 会在需要时重建。无法重新生成的数据（Archives）绝不会出现在此列表中。删除操作都会记入日志。"
          }
        }
      }
    },
