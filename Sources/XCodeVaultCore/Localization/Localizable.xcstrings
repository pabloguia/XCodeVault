    "cli.cmd.bench.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualify a drive for developer workloads: 4 KiB random IOPS at QD1 and small-file metadata rate, not sequential MB/s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evalúa un disco para cargas de desarrollo: IOPS aleatorias de 4 KiB con QD1 y tasa de metadatos de archivos pequeños, no MB/s secuenciales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "開発作業向けにドライブを評価します: 連続 MB/s ではなく、QD1 での 4 KiB ランダム IOPS と小さなファイルのメタデータ処理速度。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avalia um disco para cargas de desenvolvimento: IOPS aleatórios de 4 KiB em QD1 e taxa de metadados de arquivos pequenos, não MB/s sequenciais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "评估磁盘是否适合开发工作负载：看 QD1 下的 4 KiB 随机 IOPS 和小文件元数据速率，而不是顺序 MB/s。"
          }
        }
      }
    },
    "cli.cmd.clean.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan (default) or apply deletion of regenerable developer data. Never touches Archives or anything non-regenerable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planifica (por omisión) o aplica la eliminación de datos de desarrollo regenerables. Nunca toca Archives ni nada que no se pueda regenerar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "再生成できる開発データの削除を計画（既定）または実行します。Archives や再生成できないものには一切触れません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planeja (padrão) ou aplica a exclusão de dados de desenvolvimento regeneráveis. Nunca toca em Archives nem em nada que não possa ser regenerado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "规划（默认）或执行删除可再生成的开发数据。从不触碰 Archives 或任何无法再生成的数据。"
          }
        }
      }
    },
