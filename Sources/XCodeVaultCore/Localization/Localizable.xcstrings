    "perm.fda.next.notGranted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if `scan` marks a size [partial: unreadable entries]: System Settings ▸ Privacy & Security ▸ Full Disk Access, switch on the app you run XCodeVault from (XCodeVault.app, or your terminal for xcodevaultctl), then scan again. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo si `scan` marca un tamaño [partial: unreadable entries]: Ajustes del Sistema ▸ Privacidad y seguridad ▸ Acceso total al disco, activa la app desde la que ejecutas XCodeVault (XCodeVault.app, o tu terminal para xcodevaultctl) y vuelve a analizar. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "`scan` がサイズに [partial: unreadable entries] と表示した場合のみ: システム設定 ▸ プライバシーとセキュリティ ▸ フルディスクアクセスで、XCodeVault を実行するアプリ（XCodeVault.app、または xcodevaultctl の場合はターミナル）をオンにして、もう一度スキャンします。%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Só se `scan` marcar um tamanho [partial: unreadable entries]: Ajustes do Sistema ▸ Privacidade e Segurança ▸ Acesso Total ao Disco, ative o app em que você executa o XCodeVault (XCodeVault.app, ou o seu terminal para o xcodevaultctl) e analise de novo. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅当 `scan` 将某个大小标记为 [partial: unreadable entries] 时：在系统设置 ▸ 隐私与安全性 ▸ 完全磁盘访问权限中，打开你用来运行 XCodeVault 的应用（XCodeVault.app，或运行 xcodevaultctl 的终端），然后重新扫描。%@"
          }
        }
      }
    },
    "perm.fda.next.unknown" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to do unless `scan` marks a size [partial: unreadable entries]; then grant Full Disk Access as for \"not granted\"."
