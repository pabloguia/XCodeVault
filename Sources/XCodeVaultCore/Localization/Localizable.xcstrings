        }
      }
    },
    "app.prep.notSudo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCodeVault runs this without asking for your password. If it fails, nothing else is tried: the log has the exact command to run yourself in Terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault ejecuta esto sin pedir tu contraseña. Si falla, no se intenta nada más: el registro tiene el comando exacto para ejecutarlo tú en Terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault はパスワードを求めずにこれを実行します。失敗した場合はほかに何も試しません。ログに、ターミナルで自分で実行するための正確なコマンドがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O XCodeVault executa isto sem pedir sua senha. Se falhar, nada mais é tentado: o registro tem o comando exato para você executar no Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault 运行此操作时不会询问密码。如果失败，不会尝试其他操作：日志中有可在“终端”中自行运行的确切命令。"
          }
        }
      }
    },
