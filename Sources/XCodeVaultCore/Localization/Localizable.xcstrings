    "app.plan.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Run…, or copy a command for Terminal. Each command previews its changes first, unless it’s marked “acts immediately”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa Ejecutar… o copia un comando para Terminal. Cada comando muestra antes sus cambios, salvo que esté marcado como “actúa de inmediato”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「実行…」を使うか、ターミナル用にコマンドをコピーします。「すぐに実行されます」と表示されていない限り、各コマンドは先に変更内容を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use Executar… ou copie um comando para o Terminal. Cada comando mostra antes o que vai mudar, a menos que esteja marcado como “age imediatamente”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用“运行…”，或拷贝命令到终端。除非标为“立即生效”，每条命令都会先预览更改。"
          }
        }
      }
