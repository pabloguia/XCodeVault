    "savings.bucket.runFromExternal.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run from an external drive"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
