    "app.clean.privileged.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s deleted, not moved to the Trash. Simulators may run slower until the cache is rebuilt, and what rebuilds it isn’t known yet. XCodeVault refuses while Xcode, a simulator or a build is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se elimina, no se traslada a la papelera. Los simuladores pueden ir más lentos hasta que la caché se vuelva a generar, y aún no se sabe qué la regenera. XCodeVault se niega mientras se ejecutan Xcode, un simulador o una compilación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ゴミ箱には入れず、削除します。キャッシュが作り直されるまでシミュレータの動作が遅くなることがあり、何が作り直すかはまだわかっていません。Xcode、シミュレータ、ビルドのいずれかが実行中の場合、XCodeVault は実行しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "É apagado, não movido para o Lixo. Os simuladores podem ficar mais lentos até o cache ser recriado, e ainda não se sabe o que o recria. O XCodeVault recusa enquanto o Xcode, um simulador ou uma compilação estiver em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它会被删除，而不是移到废纸篓。在缓存重建之前，模拟器可能运行较慢，而由什么重建它尚不清楚。当 Xcode、模拟器或构建正在运行时，XCodeVault 会拒绝执行。"
          }
        }
      }
    },
    "app.clean.selectToDelete" : {
