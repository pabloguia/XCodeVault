            "value" : "先复制并验证；只有在第二个明确的步骤中才会删除原件。"
          }
        }
      }
    },
    "cli.plan.note.derivedDataExternal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing DerivedData stays where it is; `xcodevaultctl clean --category derivedData` reclaims it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El DerivedData existente se queda donde está; `xcodevaultctl clean --category derivedData` lo recupera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "既存の DerivedData はそのまま残ります。`xcodevaultctl clean --category derivedData` で回収できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
