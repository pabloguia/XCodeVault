    "app.access.fda.hint.inList" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll to the end of the list — XCodeVault is listed alphabetically, near the bottom — and turn its switch on. If it isn’t there, click + and choose XCodeVault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desplázate hasta el final de la lista (XCodeVault aparece por orden alfabético, cerca del final) y activa su interruptor. Si no aparece, haz clic en + y elige XCodeVault."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リストの末尾までスクロールし（XCodeVault はアルファベット順で下の方にあります）、スイッチをオンにしてください。表示されない場合は、+ をクリックして XCodeVault を選択します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Role até o fim da lista — o XCodeVault aparece em ordem alfabética, perto do final — e ative a chave dele. Se ele não estiver lá, clique em + e escolha o XCodeVault."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "滚动到列表末尾（XCodeVault 按字母顺序排在靠下的位置），然后打开它的开关。如果没有，请点按 + 并选择 XCodeVault。"
          }
        }
      }
    },
    "app.access.fda.hint.relaunch" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turned it on, relaunch XCodeVault so the change takes effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si lo activaste, vuelve a abrir XCodeVault para que el cambio surta efecto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンにした場合は、変更を反映するために XCodeVault を再起動してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se você ativou, reabra o XCodeVault para a mudança ter efeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如果你已打开，请重新启动 XCodeVault 以使更改生效。"
          }
        }
      }
    },
    "app.access.fda.why.granted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCodeVault can measure the folders macOS protects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault puede medir las carpetas que macOS protege."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault は macOS が保護するフォルダを計測できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O XCodeVault consegue medir as pastas que o macOS protege."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault 可以计算 macOS 保护的文件夹的大小。"
          }
        }
      }
    },
    "app.access.fda.why.protected" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every folder the scan reached was read. Turn it on only if you want protected folders measured too; it may add to the totals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se leyeron todas las carpetas que alcanzó el análisis. Actívalo solo si quieres medir también las carpetas protegidas; puede aumentar los totales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スキャンで到達したフォルダはすべて読み取れました。保護されたフォルダも計測したい場合にのみオンにしてください。合計が増える場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todas as pastas que a análise alcançou foram lidas. Ative só se quiser medir também as pastas protegidas; isso pode aumentar os totais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "扫描到达的每个文件夹都已读取。只有当你也想测量受保护的文件夹时才需要打开；总计可能会增加。"
          }
        }
      }
    },
    "app.access.fda.why.unknown" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCodeVault couldn’t tell whether it has Full Disk Access. Click Check Again; nothing needs it unless a size is marked partial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault no pudo saber si tiene acceso total al disco. Haz clic en Volver a comprobar; no hace falta salvo que un tamaño aparezca como parcial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault にフルディスクアクセスがあるか判断できませんでした。「もう一度確認」をクリックしてください。サイズが「部分的」と表示されていない限り必要ありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O XCodeVault não conseguiu saber se tem Acesso Total ao Disco. Clique em Verificar de Novo; nada precisa dele, a menos que um tamanho esteja marcado como parcial."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault 无法判断自己是否拥有完全磁盘访问权限。请点按“重新检查”；除非某个大小标为部分，否则不需要它。"
          }
        }
      }
    },
    "app.access.fda.why.unreadable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some folders could not be read; Full Disk Access may let XCodeVault measure them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudieron leer algunas carpetas; el Acceso total al disco puede permitir que XCodeVault las mida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一部のフォルダを読み取れませんでした。フルディスクアクセスがあれば XCodeVault が計測できる可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algumas pastas não puderam ser lidas; o Acesso Total ao Disco pode permitir que o XCodeVault as meça."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有些文件夹无法读取；完全磁盘访问权限可能让 XCodeVault 能够计算它们的大小。"
          }
        }
      }
    },
