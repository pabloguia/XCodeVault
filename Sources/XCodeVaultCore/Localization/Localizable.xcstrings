    "cli.plan.note.archivesPark" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies and verifies first; the original is removed only in a second, explicit step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primero copia y verifica; el original se elimina solo en un segundo paso explícito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "まずコピーして検証します。元のデータの削除は、別の明示的な手順でのみ行われます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primeiro copia e verifica; o original só é removido em uma segunda etapa, explícita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "先复制并验证；只有在第二个明确的步骤中才会删除原件。"
          }
        }
      }
    },
    "cli.plan.note.derivedDataExternal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
