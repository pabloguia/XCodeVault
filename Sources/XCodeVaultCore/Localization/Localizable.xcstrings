      }
    },
    "cli.cmd.report.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full scan + doctor findings, suitable for a GitHub issue (home directory, account name, volume labels and volume UUIDs redacted)."
          }
