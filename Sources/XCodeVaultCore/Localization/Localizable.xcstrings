          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この一覧からは削除されません。ターミナル用にコマンドをコピーするか、ランタイムは「実行…」を使います。シミュレータデバイスを削除すると、その App のデータも削除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nunca são apagados desta lista. Copie um comando para o Terminal ou use Executar… para um runtime. Apagar um dispositivo de simulador apaga os dados dos apps dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "不会从此列表中删除。拷贝命令到终端，或对运行时使用“运行…”。删除模拟器设备会删除其 App 的数据。"
          }
        }
      }
