        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um runtime está sendo descarregado. Parar o simctl no meio pode deixar o runtime apagado enquanto o histórico diz que a operação falhou, então o XCodeVault não pode encerrar até ela terminar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
