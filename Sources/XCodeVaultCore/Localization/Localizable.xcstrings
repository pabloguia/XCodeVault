    "cli.cmd.runtime.offload.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete an installed runtime only if its installer already sits in the Runtime Library (export first if not). Two-phase, journaled. The round trip that makes this safe — devices returning when the runtime is re-imported — has been observed twice on one configuration and at the same version; see `compatibility`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina un runtime instalado solo si su instalador ya está en la Runtime Library (expórtalo antes si no). En dos fases, con registro. El viaje de ida y vuelta que lo hace seguro —los dispositivos regresan cuando se vuelve a importar el runtime— se ha observado dos veces, en una sola configuración y con la misma versión; consulta `compatibility`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "インストーラがすでに Runtime Library にある場合に限り、インストール済みのランタイムを削除します（なければ先に書き出してください）。2 段階で、ジャーナルに記録されます。これを安全にする往復 — ランタイムを再度読み込むとデバイスが戻ること — は、1 つの構成・同じバージョンで 2 回確認されただけです。`compatibility` を参照してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apaga um runtime instalado somente se o instalador dele já estiver na Runtime Library (exporte antes, se não estiver). Em duas fases, com registro. O retorno que torna isso seguro — os dispositivos voltando quando o runtime é reimportado — foi observado duas vezes, numa única configuração e na mesma versão; veja `compatibility`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅当已安装运行时的安装器已在 Runtime Library 中时才删除它（如果没有，请先导出）。分两个阶段，记入日志。保证安全的往返——重新导入运行时后设备恢复——仅在一种配置、同一版本上观察到两次；参见 `compatibility`。"
          }
        }
      }
    },
