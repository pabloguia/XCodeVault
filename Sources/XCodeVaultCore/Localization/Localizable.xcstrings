    },
    "cli.cmd.permissions.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only. Full Disk Access and the privileged helper: the state of each, why, and the one next step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
