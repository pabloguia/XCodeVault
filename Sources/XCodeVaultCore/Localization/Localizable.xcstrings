    "app.run.removeOriginal.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The copy is verified. Removing the original frees its space on this Mac; XCodeVault compares it with the vault copy again first and deletes nothing if they differ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La copia está verificada. Eliminar el original libera su espacio en este Mac; antes, XCodeVault lo vuelve a comparar con la copia del disco bóveda y no elimina nada si difieren."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コピーは検証済みです。元のデータを削除するとこの Mac の空き容量が増えます。XCodeVault は先に保管庫のコピーともう一度比較し、違いがあれば何も削除しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A cópia está verificada. Remover o original libera o espaço neste Mac; antes, o XCodeVault compara de novo com a cópia no disco-cofre e não apaga nada se forem diferentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拷贝已验证。移除原件会释放这台 Mac 上的空间;XCodeVault 会先再次与保险库中的拷贝比较,如有差异则不删除任何内容。"
          }
        }
      }
    },
