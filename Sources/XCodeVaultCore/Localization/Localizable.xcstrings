        }
      }
    },
    "cli.cmd.permissions.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only. Full Disk Access and the privileged helper: the state of each, why, and the one next step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo lectura. Acceso total al disco y el asistente con privilegios: el estado de cada uno, el motivo y el siguiente paso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "読み取り専用。フルディスクアクセスと特権ヘルパー: それぞれの状態、その理由、次に行う一つの手順。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Somente leitura. Acesso Total ao Disco e o auxiliar privilegiado: o estado de cada um, o motivo e o próximo passo."
          }
        },
        "zh-Hans" : {
