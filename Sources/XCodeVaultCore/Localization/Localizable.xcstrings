    "perm.requirement.appFullDiskAccess.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS privacy protection stopped XCodeVault from reading some folders, so their sizes are missing from the totals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La protección de privacidad de macOS impidió que XCodeVault leyera algunas carpetas, así que sus tamaños faltan en los totales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS のプライバシー保護により XCodeVault が一部のフォルダを読み取れなかったため、それらのサイズは合計に含まれていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
