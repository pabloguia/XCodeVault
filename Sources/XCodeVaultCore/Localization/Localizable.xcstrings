{
  "sourceLanguage" : "en",
  "strings" : {
    "app.access.fda.action.openSettings" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Full Disk Access Settings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abrir los ajustes de Acceso total al disco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フルディスクアクセスの設定を開く"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abrir os Ajustes de Acesso Total ao Disco"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打开完全磁盘访问权限设置"
          }
        }
      }
    },
    "app.access.fda.action.recheck" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volver a comprobar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "もう一度確認"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verificar de novo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "重新检查"
          }
        }
      }
    },
    "app.access.fda.why.granted" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCodeVault can measure the folders macOS protects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault puede medir las carpetas que macOS protege."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault は macOS が保護するフォルダを計測できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O XCodeVault consegue medir as pastas que o macOS protege."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault 可以计算 macOS 保护的文件夹的大小。"
          }
        }
      }
    },
    "app.access.fda.why.protected" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every folder this scan reached was read. Grant Full Disk Access only if you want the folders macOS protects measured too; it may add to the totals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se leyeron todas las carpetas que alcanzó este análisis. Concede el Acceso total al disco solo si quieres medir también las carpetas que macOS protege; los totales pueden aumentar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今回のスキャンで到達したフォルダはすべて読み取れました。macOS が保護するフォルダも計測したい場合にのみフルディスクアクセスを許可してください。合計が増える可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todas as pastas que esta análise alcançou foram lidas. Conceda o Acesso Total ao Disco só se quiser medir também as pastas que o macOS protege; os totais podem aumentar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本次扫描到达的文件夹都已读取。只有在你也想计算 macOS 保护的文件夹时才需要授予完全磁盘访问权限；总量可能会增加。"
          }
        }
      }
    },
    "app.access.fda.why.unknown" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The check could not tell whether XCodeVault has Full Disk Access. Check again; nothing here needs it unless a size is marked partial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La comprobación no pudo determinar si XCodeVault tiene Acceso total al disco. Vuelve a comprobarlo; nada aquí lo necesita salvo que un tamaño esté marcado como parcial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault にフルディスクアクセスがあるかどうかを判定できませんでした。もう一度確認してください。サイズが部分的と表示されていない限り、ここで必要なものはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A verificação não conseguiu determinar se o XCodeVault tem Acesso Total ao Disco. Verifique de novo; nada aqui precisa dele, a menos que um tamanho esteja marcado como parcial."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "检查无法确定 XCodeVault 是否拥有完全磁盘访问权限。请再检查一次；除非某个大小被标记为不完整，否则这里不需要它。"
          }
        }
      }
    },
    "app.access.fda.why.unreadable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some folders could not be read; Full Disk Access may let XCodeVault measure them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudieron leer algunas carpetas; el Acceso total al disco puede permitir que XCodeVault las mida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一部のフォルダを読み取れませんでした。フルディスクアクセスがあれば XCodeVault が計測できる可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algumas pastas não puderam ser lidas; o Acesso Total ao Disco pode permitir que o XCodeVault as meça."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有些文件夹无法读取；完全磁盘访问权限可能让 XCodeVault 能够计算它们的大小。"
          }
        }
      }
    },
    "app.access.fda.why.unreadableFolders" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld folder could not be read; Full Disk Access may let XCodeVault measure it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld folders could not be read; Full Disk Access may let XCodeVault measure them."
