    "app.delete.otherTools.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never deleted from this list. Copy a command for Terminal, or use Run… for a runtime. Deleting a simulator device deletes its apps’ data."
          }
