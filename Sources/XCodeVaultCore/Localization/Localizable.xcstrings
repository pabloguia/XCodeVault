    "app.prep.useDrive.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCodeVault registers this volume as a vault, then creates XCodeVault/DerivedData, XCodeVault/Archives and XCodeVault/Runtimes on it. Nothing is erased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault registra este volumen como disco bóveda y luego crea XCodeVault/DerivedData, XCodeVault/Archives y XCodeVault/Runtimes en él. No se borra nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault はこのボリュームを保管庫として登録し、XCodeVault/DerivedData、XCodeVault/Archives、XCodeVault/Runtimes を作成します。何も消去しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O XCodeVault registra este volume como disco-cofre e depois cria XCodeVault/DerivedData, XCodeVault/Archives e XCodeVault/Runtimes nele. Nada é apagado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault 将此宗卷登记为保险库，然后在其上创建 XCodeVault/DerivedData、XCodeVault/Archives 和 XCodeVault/Runtimes。不会抹掉任何内容。"
          }
        }
      }
    },
