{
  "sourceLanguage" : "en",
  "strings" : {
    "cli.cmd.plan.abstract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only. What to run to reclaim space one way: delete, park, or run from an external drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo lectura. Qué ejecutar para recuperar espacio de una forma: eliminar, aparcar o usar desde una unidad externa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "読み取り専用。容量を回収する方法ごとの実行コマンド: 削除、退避、または外付けドライブから実行。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Somente leitura. O que executar para recuperar espaço de um jeito: apagar, estacionar ou rodar de um disco externo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只读。按一种方式回收空间时该运行什么：删除、转存，或从外置硬盘运行。"
          }
        }
      }
    },
