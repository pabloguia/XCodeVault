          }
        }
      }
    },
    "cli.plan.note.exportFirst" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First export its installer: `xcodevaultctl runtime export <platform> --to <dir>`."
          }
        },
        "es" : {
