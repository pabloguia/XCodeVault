    "app.overview.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Options marked Experimental haven’t been verified on your versions of macOS and Xcode. XCodeVault never deletes non-regenerable data automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las opciones marcadas como experimentales no se han verificado en tus versiones de macOS y Xcode. XCodeVault nunca elimina automáticamente datos que no se pueden regenerar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「実験的」と表示されたオプションは、お使いの macOS と Xcode のバージョンでは検証されていません。XCodeVault は再生成できないデータを自動的に削除することはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As opções marcadas como Experimental não foram verificadas nas suas versões do macOS e do Xcode. O XCodeVault nunca apaga automaticamente dados que não podem ser regenerados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "标为“实验性”的选项尚未在你的 macOS 和 Xcode 版本上验证。XCodeVault 绝不会自动删除无法重新生成的数据。"
          }
        }
      }
