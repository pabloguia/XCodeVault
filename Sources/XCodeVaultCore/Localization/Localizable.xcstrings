    "app.plan.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XCodeVault does not run these from the app. Copy a command and run it in Terminal: each one shows what it would do before it does it, unless it is marked “acts immediately”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault no ejecuta estos comandos desde la app. Copia un comando y ejecútalo en Terminal: cada uno muestra lo que haría antes de hacerlo, salvo los marcados «actúa de inmediato»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault はこれらをアプリから実行しません。コマンドをコピーしてターミナルで実行してください。「すぐに実行されます」と表示されたもの以外は、実行前に何をするかを表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O XCodeVault não executa estes comandos pelo app. Copie um comando e execute-o no Terminal: cada um mostra o que faria antes de fazer, a menos que esteja marcado “age imediatamente”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XCodeVault 不会在 App 中运行这些命令。请拷贝命令并在“终端”中运行：除标有“立即生效”的命令外，每条命令都会先显示将要执行的操作。"
          }
        }
      }
    },
    "app.plan.vault.attention" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault on %@ is connected but not usable; `xcodevaultctl doctor` says what is wrong."
          }
        },
        "es" : {
          "stringUnit" : {
