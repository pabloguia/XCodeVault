    "app.drives.ownership.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ownership is ignored on “%@”. In Finder, choose File ▸ Get Info and turn off “Ignore ownership on this volume” (Finder asks for your password), or copy the command for Terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La propiedad se ignora en “%@”. En el Finder, elige Archivo ▸ Obtener información y desactiva “Ignorar la propiedad en este volumen” (el Finder pide tu contraseña), o copia el comando para Terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” では所有権が無視されています。Finder で「ファイル」▸「情報を見る」を選び、「このボリューム上の所有権を無視」をオフにする（Finder がパスワードを求めます）か、ターミナル用のコマンドをコピーしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A posse é ignorada em “%@”. No Finder, escolha Arquivo ▸ Obter Informações e desative “Ignorar posse neste volume” (o Finder pede sua senha), ou copie o comando para o Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@”忽略了所有权。在访达中选取“文件”▸“显示简介”，关闭“忽略此宗卷上的所有权”（访达会要求输入密码），或拷贝用于“终端”的命令。"
          }
        }
      }
    },
