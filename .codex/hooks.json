{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/.codex/hooks/helper-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/.codex/hooks/swift-format-lint.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
