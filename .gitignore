.build/
*.xcodeproj
xcuserdata/
DerivedData/
.swiftpm/
*.sparseimage
.DS_Store
/dist/
.token-pilot/
*.tmp
# scripts/bundle-app.sh's restore copy. A SIGKILL between the edit and the trap leaves both this
# file and a real team id in a tracked source file; at least keep this one out of the index.
*.bundle-bak
# Per-machine agent permission grants. These were only ever ignored by the owner's *global*
# gitignore, which no contributor has — Claude Code and Codex write these files the first time
# a permission is granted, so without this line the first outside contributor gets an untracked
# file holding their local grants and paths, sitting there waiting for a `git add -A`.
.claude/settings.local.json
.codex/settings.local.json

# Generated by scripts/coverage-to-sonar.sh from the LLVM profile, for the Sonar scan to import.
# Never committed: a checked-in copy would be imported as if it described the current commit, which
# is the "measured something, but not this" failure scripts/sonar-verify.sh exists to catch.
/coverage.xml
# The Sonar scanner's working directory. It holds report-task.txt — the server task id and the URLs
# the verification step reads — which is per-run state, not source.
.scannerwork/
